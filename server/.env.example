OPENAI_API_KEY=your_openai_api_key
# Optional OpenAI-compatible endpoint override (proxy/self-hosted). Defaults to https://api.openai.com/v1.
# OPENAI_BASE_URL=
SERPAPI_KEY=your_serpapi_key
# pgvector (default) | local | qdrant. Strict allowlist: any other value is a
# startup/ingest/search error, never a fallback. pgvector keeps chunks and
# vectors in PostgreSQL (POSTGRES_DATABASE_URL, see docker-compose.yml) and runs
# dense cosine + PostgreSQL full-text search as two routes fused with RRF.
VECTOR_STORE_PROVIDER=pgvector
# Chunk/vector table for the pgvector provider.
DOCUMENT_CHUNKS_POSTGRES_TABLE=rag_document_chunks
# Width of the pgvector column. Leave empty to derive it from
# OPENAI_EMBEDDING_MODEL (text-embedding-3-small=1536, -large=3072). Changing
# the model or width requires `npm run vector:reindex -- --from documents --apply`.
RAG_EMBEDDING_DIMENSIONS=
# PostgreSQL text search configuration for the lexical route. `simple` matches
# the app-side tokenizer (per-character CJK, lowercase ASCII) and is ranked with
# ts_rank_cd (not BM25).
RAG_PGVECTOR_TEXT_SEARCH_CONFIG=simple
# hnsw (default) or ivfflat; both use cosine distance.
RAG_PGVECTOR_INDEX_TYPE=hnsw
RAG_PGVECTOR_HNSW_M=16
RAG_PGVECTOR_HNSW_EF_CONSTRUCTION=64
RAG_PGVECTOR_IVFFLAT_LISTS=100
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_DISTANCE=Cosine
# Where the local vector index (vector-index.json) and other RAG data live.
# The archive MCP server (server/archive-mcp-server.js) loads that index in its
# own process, so it must resolve RAG_DATA_DIRECTORY to the same path as the API
# server or it will start against an empty index.
# RAG_DATA_DIRECTORY=
# Optional access scope for the archive MCP server. It runs in-process, so it
# does not pass through API auth; set these to restrict which documents an
# external agent runtime can retrieve.
# ARCHIVE_MCP_USER_ID=
# ARCHIVE_MCP_WORKSPACE_ID=
# Set to 1 to run with no infrastructure at all: the document registry and PDF
# bytes go to files under RAG_DATA_DIRECTORY instead of PostgreSQL, and long
# memory, tasks, agent runs, workspace artifacts and the admin audit log fall back
# to in-process stores. Honoured by the API server (server.js), the archive MCP
# server and the ingest CLI (npm run archive:ingest). See server/standalone-profile.js.
# DOCCOMPARE_STANDALONE=1
# The two settings below are managed by that profile -- they describe which backend
# is installed so the health report does not probe PostgreSQL for a registry that
# is file-backed. Setting them by hand does not switch any store, it only changes
# what /health claims, so leave them alone unless you are injecting stores yourself.
# DOCUMENT_STORE_PROVIDER=postgres
# SESSION_MEMORY_STORE_PROVIDER=postgres
# Where user data is stored. Normally leave all four unset: they default to a
# directory beside the source, and fall back to the OS user-data directory
# (~/Library/Application Support/DocCompare, %APPDATA%\DocCompare, or
# $XDG_DATA_HOME/doccompare) when that is not writable -- which is the case for a
# single-file binary, a .app, and a root-owned global npm install. An existing data
# directory is always preferred, so setting these is only needed to relocate
# storage deliberately.
# RAG_DATA_DIRECTORY=
# UPLOADS_DIRECTORY=
# UPLOAD_SESSION_DIRECTORY=
# FEEDBACK_DIRECTORY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5
# Planner calls send a per-request JSON Schema response_format. Set false only for
# an OpenAI-compatible endpoint that rejects response_format.
RAG_STRUCTURED_OUTPUT_ENABLED=true
# llm: claims the lexical claim check rejects get a second opinion from the chat
# model, behind citation and number guards. Off by default until calibrated.
RAG_CLAIM_JUDGE=off
# Optional second chat model the chat and planner routes fail over to after the
# primary keeps failing with a retriable error (429, 5xx, timeout).
OPENAI_CHAT_FALLBACK_MODEL=
# Per-request timeout for model calls; a timed-out request is retried like a 5xx.
RAG_LLM_REQUEST_TIMEOUT_MS=120000
# Per model endpoint: requests in flight (0 = no cap), and a circuit breaker that
# opens after consecutive 5xx/timeouts (0 = off) for the cooldown.
RAG_LLM_MAX_CONCURRENCY=8
RAG_LLM_CIRCUIT_FAILURE_THRESHOLD=5
RAG_LLM_CIRCUIT_COOLDOWN_MS=30000
# Per-run ceilings on model usage; the next tool is skipped once one is used up.
# 0 turns a ceiling off.
AGENT_RUN_MAX_TOKENS=100000
AGENT_RUN_MAX_COST_USD=0.5
AGENT_RUN_MAX_DURATION_MS=300000
AGENT_PLANNER_ROLLOUT=llm
AGENT_INTENT_PLANNER=llm
AGENT_EXECUTION_PLANNER=llm
# guarded (default) runs custom Skills as a typed DAG; off is the V1 chain opt-out;
# shadow plans a graph beside the chain. An unrecognized value resolves to off.
AGENT_SKILL_GRAPH_ROLLOUT=guarded
# off | shadow; heterogeneous DAG is proposal-only until execution/recovery gates exist.
AGENT_UNIFIED_GRAPH_ROLLOUT=off
RAG_PROMPT_VERSION=v2
RAG_CHUNK_STRATEGY=structured
# Dense + sparse multi-route retrieval is on by default and fused with RRF;
# `weighted` stays available. Set RAG_HYBRID_ENABLED=false only for a dense-only
# baseline -- that is an opt-out, not the default.
RAG_HYBRID_ENABLED=true
RAG_HYBRID_FUSION=rrf
RAG_HYBRID_DENSE_WEIGHT=0.65
RAG_HYBRID_SPARSE_WEIGHT=0.35
RAG_RRF_K=60
RAG_QUERY_DECOMPOSITION_ENABLED=true
RAG_QUERY_DECOMPOSITION_MAX_REQUIREMENTS=4
RAG_RERANK_ENABLED=false
RAG_RERANK_PROVIDER=heuristic
RAG_RERANK_CANDIDATE_MULTIPLIER=3
RAG_RERANK_WEIGHT=0.6
RAG_CROSS_ENCODER_ENDPOINT=
RAG_CROSS_ENCODER_MODEL=
# HTTP timeout for the cross-encoder rerank endpoint (milliseconds).
RAG_CROSS_ENCODER_TIMEOUT_MS=30000
# Query-embedding LRU cache: identical queries reuse cached vectors.
RAG_EMBEDDING_CACHE_ENABLED=true
RAG_EMBEDDING_CACHE_MAX=256
RAG_EMBEDDING_CACHE_TTL_MS=600000
# Defaults to enabled when POSTGRES_DATABASE_URL or LONG_MEMORY_DATABASE_URL is configured.
# Set these to false to force memory off even when PostgreSQL is configured.
# RAG_LONG_MEMORY_ENABLED=false
# RAG_AGENT_EXPERIENCE_MEMORY_ENABLED=false
RAG_OBSERVABILITY_ENABLED=false
RAG_OBSERVABILITY_INCLUDE_CONTEXT=false
# OpenTelemetry tracing (see docs/configuration.md). Off by default; the exporter
# reads the standard OTEL_EXPORTER_OTLP_* variables. Phoenix needs http/protobuf.
OTEL_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public:secret)>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
RAG_LLMOPS_POLICY_ENABLED=true
RAG_LLMOPS_ENFORCEMENT_MODE=record
# Optional per-event gates. Leave empty to record policy verdicts without blocking.
RAG_LLMOPS_MAX_COST_USD_PER_EVENT=
RAG_LLMOPS_MAX_TOKENS_PER_EVENT=
RAG_LLMOPS_ALERT_ERRORS=true
RAG_LLMOPS_ALERT_LATENCY_SLO=true
RAG_LLMOPS_ALERT_BUDGET_EXCEEDED=true
RAG_LLMOPS_ALERT_ESTIMATED_USAGE=false
RAG_LLMOPS_ALERT_PRICING_UNAVAILABLE=false
POSTGRES_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agentai
POSTGRES_SSL_ENABLED=false
# Row-level security: enforce (default) runs scoped requests and tasks under the
# tenant role so PostgreSQL rejects other tenants' rows; off keeps the owner role.
POSTGRES_ROW_LEVEL_SECURITY=enforce
POSTGRES_TENANT_ROLE=archive_rag_tenant
# Multi-instance deployments: share circuit breakers, the model concurrency cap
# and the claim-judge cache in Redis (docker compose --profile shared-state up -d).
RAG_SHARED_STATE=memory
REDIS_URL=redis://127.0.0.1:6379
RAG_SHARED_STATE_PREFIX=archive_rag:
LONG_MEMORY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agentai
LONG_MEMORY_POSTGRES_TABLE=long_memory_items
LONG_MEMORY_POSTGRES_SSL_ENABLED=false
DOCUMENTS_POSTGRES_TABLE=rag_documents
SESSION_MEMORY_POSTGRES_TABLE=rag_session_memory
TASK_STORE_PROVIDER=auto
TASKS_POSTGRES_TABLE=rag_tasks
TASK_EVENTS_POSTGRES_TABLE=rag_task_events
# auto uses PostgreSQL when configured; memory is local-only and resets on restart.
WORKSPACE_ARTIFACT_STORE_PROVIDER=auto
WORKSPACE_ARTIFACTS_POSTGRES_TABLE=rag_workspace_artifacts
AGENT_RUN_STORE_PROVIDER=auto
AGENT_RUN_RECOVERY_MODE=
AGENT_RUNS_POSTGRES_TABLE=rag_agent_runs
AGENT_RUN_EVENTS_POSTGRES_TABLE=rag_agent_run_events
ADMIN_AUDIT_STORE_PROVIDER=auto
ADMIN_AUDIT_EVENTS_POSTGRES_TABLE=rag_admin_audit_events
ADMIN_AUDIT_RETENTION_DAYS=90
API_AUTH_ENABLED=false
API_AUTH_TOKEN=change-me-for-local-dev
# Comma-separated CORS origin allowlist. Empty allows any origin (local dev only).
ALLOWED_ORIGINS=http://localhost:3000
# Per-minute rate limits. Enabled via RATE_LIMIT_ENABLED=true (recommended).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_UPLOAD_MAX=120
RATE_LIMIT_DESTRUCTIVE_MAX=5
# Idle chunked-upload sessions older than this are removed at startup (milliseconds).
UPLOAD_SESSION_TTL_MS=86400000
# API_AUTH_TOKENS can include admin roles/permissions, for example:
# {"admin-token":{"userId":"admin","workspaceId":"workspace-a","roles":["admin.operator"]}}
API_AUTH_TOKENS=
API_AUTH_REQUIRE_WORKSPACE=false
API_AUTH_JWT_ENABLED=false
API_AUTH_JWT_HS256_SECRET=
API_AUTH_JWT_SECRET=
API_AUTH_JWT_ISSUER=
API_AUTH_JWT_AUDIENCE=
API_AUTH_JWT_USER_CLAIM=sub
API_AUTH_JWT_WORKSPACE_CLAIM=workspace_id
API_AUTH_JWT_WORKSPACES_CLAIM=workspaces
API_AUTH_JWT_ROLES_CLAIM=roles
API_AUTH_JWT_PERMISSIONS_CLAIM=permissions
API_AUTH_REVOKED_TOKEN_HASHES=
API_AUTH_REVOKED_JTIS=
FEEDBACK_DIRECTORY=
STARTUP_HEALTH_STRICT=false
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=180
RAG_RETRIEVAL_TOP_K=6
RAG_SPARSE_TOP_K=8
RAG_COMPARE_TOP_K_PER_DOC=3
RAG_MIN_QUERY_TERM_COVERAGE=0.51
# Single-document QA reads its own floor. Lowering it answers more paraphrased
# questions but also admits adjacent-topic chunks; see docs/evaluation.md.
RAG_MIN_QA_QUERY_TERM_COVERAGE=0.51
# Opt-in second abstention signal: the QA answer model may reply
# NOT_IN_EVIDENCE: and abstain, and single-part questions also admit chunks
# from the partial floor up unless a query word was replaced by a rival
# ("parental leave" vs "annual leave"). Off by default; see docs/evaluation.md.
RAG_QA_ANSWER_VERDICT=false
RAG_QA_PARTIAL_COVERAGE_FLOOR=0.3
# With the verdict on, a NOT_IN_EVIDENCE reply retrieves once more this deep
# and answers again from chunks the model has not seen; 0 turns it off.
RAG_QA_VERDICT_RETRY_TOP_K=18
