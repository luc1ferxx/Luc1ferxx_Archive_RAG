{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:api": "ARCHIVE_RAG_ROLE=api node server.js",
    "start:agent": "ARCHIVE_RAG_ROLE=agent node server.js",
    "start:retrieval": "ARCHIVE_RAG_ROLE=retrieval node server.js",
    "start:model-gateway": "ARCHIVE_RAG_ROLE=model-gateway node server.js",
    "service:keys": "node service-keys.mjs",
    "archive:ingest": "node archive-ingest.mjs",
    "vector:reindex": "node vector-reindex.mjs",
    "vector:index": "node vector-index.mjs",
    "vector:sparse-length": "node sparse-length-backfill.mjs",
    "ingest:jobs": "node ingest-jobs.mjs",
    "test:pgvector": "node --test --test-concurrency=1 test/vector-store-pgvector.integration.test.mjs test/vector-store-pgvector-versions.integration.test.mjs test/agent-execution-graph-postgres.integration.test.mjs test/agent-unified-graph-postgres.integration.test.mjs test/postgres-row-level-security.integration.test.mjs test/ingest-jobs-postgres.integration.test.mjs test/ingest-pipeline-postgres.integration.test.mjs test/vector-store-pgvector-bm25.integration.test.mjs test/retrieval-service-pgvector.integration.test.mjs",
    "test:pgvector-replica": "bash scripts/run-pgvector-replica-integration.sh",
    "worker:ingest": "node ingest-worker.mjs",
    "eval:synthetic": "node evaluation/run-synthetic-eval.mjs",
    "eval:real": "node evaluation/run-real-eval.mjs",
    "eval:robust-suite": "node evaluation/run-eval-suite.mjs --suite robust",
    "eval:trajectory": "node evaluation/run-trajectory-eval.mjs",
    "eval:planner": "node evaluation/run-planner-eval.mjs",
    "eval:param-sweep": "node evaluation/run-param-sweep.mjs",
    "eval:rerank": "node evaluation/run-rerank-eval.mjs",
    "eval:rerank:sweep": "node evaluation/run-rerank-sweep.mjs",
    "eval:retrieval-comparison": "node evaluation/run-retrieval-comparison.mjs",
    "corpus:arxiv": "node evaluation/build-arxiv-corpus.mjs",
    "corpus:qasper": "node evaluation/import-qasper.mjs",
    "eval:qasper-answers": "node evaluation/run-qasper-answer-eval.mjs",
    "eval:unified-graph-planner": "node evaluation/run-unified-graph-planner-eval.mjs",
    "eval:sparse-scoring": "node evaluation/run-sparse-scoring-eval.mjs",
    "eval:semantic-cache": "node evaluation/run-semantic-cache-eval.mjs",
    "adapter:data": "node evaluation/query-adapter-data.mjs",
    "adapter:train": "PYTHONNOUSERSITE=1 evaluation/.venv-neural-reranker/bin/python evaluation/train-query-adapter.py",
    "eval:query-adapter": "node evaluation/run-query-adapter-eval.mjs",
    "eval:abstention-gate": "node evaluation/run-abstention-gate-analysis.mjs",
    "eval:qasper-retrieval": "node evaluation/run-qasper-retrieval-eval.mjs",
    "eval:layout-parsing": "node evaluation/run-layout-parsing-eval.mjs",
    "eval:judge": "node evaluation/run-llm-judge.mjs",
    "rerank:cross-encoder:setup": "python3 -m venv --clear evaluation/.venv-neural-reranker && PYTHONNOUSERSITE=1 evaluation/.venv-neural-reranker/bin/python -m pip install -r evaluation/neural-reranker-requirements.txt",
    "rerank:cross-encoder": "PYTHONNOUSERSITE=1 USE_TF=0 USE_FLAX=0 TRANSFORMERS_NO_TF=1 TRANSFORMERS_NO_FLAX=1 HF_HOME=evaluation/generated/huggingface evaluation/.venv-neural-reranker/bin/python evaluation/neural-cross-encoder-endpoint.py",
    "rerank:cross-encoder:docker": "docker compose -f evaluation/cross-encoder-service/compose.yaml up --build",
    "rerank:cross-encoder:local": "node evaluation/local-cross-encoder-endpoint.mjs",
    "feedback:corpus": "node evaluation/build-feedback-corpus.mjs",
    "eval:feedback": "node evaluation/build-feedback-corpus.mjs && node evaluation/run-synthetic-eval.mjs evaluation/generated/feedback-corpus.json --latest-name latest-feedback --openai-provider deterministic",
    "eval:feedback:real": "node evaluation/build-feedback-corpus.mjs && node evaluation/run-synthetic-eval.mjs evaluation/generated/feedback-corpus.json --latest-name latest-feedback --openai-provider real",
    "eval:recovery-observability": "node evaluation/run-recovery-observability-eval.mjs",
    "eval:claim-judge": "node evaluation/run-claim-judge-eval.mjs",
    "eval:answer-drafts": "node evaluation/run-answer-draft-eval.mjs",
    "trace:demo": "node evaluation/run-trace-demo.mjs",
    "eval:tenant-isolation": "node evaluation/run-tenant-isolation-eval.mjs",
    "eval:prompt-injection": "node evaluation/run-prompt-injection-eval.mjs",
    "eval:shared-state": "node evaluation/run-shared-state-eval.mjs",
    "eval:llm-resilience": "node evaluation/run-llm-resilience-eval.mjs",
    "eval:load-test": "node evaluation/run-api-load-bench.mjs",
    "eval:load-test:pgvector": "bash scripts/run-load-test-pgvector.sh",
    "eval:load-test:cluster": "bash scripts/run-load-test-pgvector.sh --instances 2",
    "eval:load-test:split": "bash scripts/run-load-test-pgvector.sh --topology split --tenant",
    "eval:load-test:ingest": "bash scripts/run-load-test-pgvector.sh --scenario ingest",
    "eval:load-test:index-switch": "bash scripts/run-load-test-pgvector.sh --scenario index-switch --instances 2 --tenant --documents 200 --embedding-latency-ms 100 --switch-phase-ms 20000 --model-latency-ms 0",
    "bench:pgvector-scale": "bash scripts/run-pgvector-scale-bench.sh",
    "eval:ragas": "python evaluation/run-ragas-eval.py",
    "bench:rerank": "node evaluation/benchmark-rerank-latency.mjs",
    "observability:report": "node evaluation/build-observability-report.mjs",
    "planner:gate": "node evaluation/check-planner-provider-gate.mjs",
    "runtime:smoke": "node evaluation/run-runtime-smoke.mjs",
    "rollout:readiness": "node evaluation/run-rollout-readiness-report.mjs",
    "quality:gate": "node evaluation/check-quality-gate.mjs",
    "quality:current": "node evaluation/check-current-quality.mjs",
    "verify:quality": "node evaluation/run-doccompare-verification.mjs",
    "robust:gate": "node evaluation/check-robust-suite.mjs",
    "release:gate": "node evaluation/check-release-evidence.mjs",
    "coverage:gate": "node test/coverage-gate.mjs",
    "coverage:targets": "node test/coverage-gate.mjs --strict-targets",
    "test": "node test/run.test.mjs"
  },
  "keywords": [],
