# Hardened tenant-isolation demo profile (server environment).
#
# DEMO ONLY, NOT FOR PRODUCTION. Every token and password in this file is a
# fixed, public demo value that anyone reading this repository knows. Never
# reuse one of them anywhere else, never expose a server started with this
# profile beyond your own machine, and replace all of them (or better: use
# OIDC) before you point real users or real documents at it.
#
# What it is: every tenant-isolation switch of tenant isolation phases 1-5
# turned on at once (docs/demo-tenant-isolation.md):
#   API auth with per-user tokens, a workspace on every request, RBAC
#   enforce, tenant membership enforce, row-level security with strict tenant
#   context, the owner/runtime database role split, data-access audit events,
#   redaction on document delete, the document trash, per-tenant rate limits,
#   concurrency caps, model quotas, storage quotas, task caps, retention,
#   envelope encryption of stored files under per-workspace keys, per-tenant
#   embedding and registry caches, and long-term memory per workspace.
#
# How to use it:
#   - compose: docker compose -f docker-compose.yml -f compose.demo.yml --profile app up -d --build
#     (compose.demo.yml loads this file and swaps the database host and the
#     model URL for the compose services);
#   - locally: start a PostgreSQL with pgvector whose split logins come from
#     deploy/postgres/create-split-roles.sql (with the two demo passwords
#     below), then from server/:
#       npm run demo:fake-model                 # in one terminal
#       DOTENV_CONFIG_PATH=../deploy/demo/hardened.env node server.js
#   then `npm run demo:seed` and `npm run demo:walkthrough` from server/.
#
# Every name below is read by the server (server/rag/config.js, server/app.js,
# server/rag/rbac.js) and documented in docs/configuration.md;
# server/test/demo-tenants.test.mjs fails on a name the server does not read
# and on tokens that differ from server/demo/tenant-demo.js.

# --- API authentication -----------------------------------------------------
API_AUTH_ENABLED=true
# Every authenticated request must resolve a workspace: a credential bound to
# one workspace gets it, every other one names it with x-workspace-id. The
# platform credentials below act for no workspace on their platform admin
# routes only (auth.js TENANTLESS_PLATFORM_PATHS).
API_AUTH_REQUIRE_WORKSPACE=true
# Demo tokens (public values). The SAME map is DEMO_PERSONAS in
# server/demo/tenant-demo.js, which demo:seed and demo:walkthrough use.
#   alice           bound to workspace alpha by the token (alpha workspace.admin)
#   alpha-library   alpha's service account: bound to alpha, no user, so what it
#                   uploads is shared by every alpha member (a user's own
#                   uploads are private to that user in its workspace)
#   anna            user only; alpha by membership (alpha workspace.viewer)
#   bob             bound to workspace beta by the token (beta workspace.admin)
#   ben             user only; beta by membership (beta workspace.member)
#   carol           may use alpha and beta (member of both), names one per request
#   dave            user only; gamma by membership (gamma workspace.admin), the
#                   "noisy neighbour" the rate-limit and storage-quota checks use
#   platform-admin  admin.owner, no workspace: erase, export, usage, audit, health
#   tenant-manager  admin.tenant_manager, no workspace: registers workspaces and members
# Workspace roles come from the tenant registry (demo:seed puts the members);
# none is in a token. alpha-library has no user, so it is no member: it gets
# RBAC_DEFAULT_ROLE (workspace.member) in the workspace its token names.
API_AUTH_TOKENS={"demo-alice-token":{"userId":"alice","workspaceId":"alpha"},"demo-alpha-library-token":{"workspaceId":"alpha"},"demo-anna-token":{"userId":"anna"},"demo-bob-token":{"userId":"bob","workspaceId":"beta"},"demo-ben-token":{"userId":"ben"},"demo-carol-token":{"userId":"carol","workspaces":["alpha","beta"]},"demo-dave-token":{"userId":"dave"},"demo-platform-admin-token":{"userId":"platform-admin","roles":["admin.owner"]},"demo-tenant-manager-token":{"userId":"tenant-manager","roles":["admin.tenant_manager"]}}
# An OIDC IdP (if you add one) may not hand out admin.* roles.
API_AUTH_OIDC_ALLOW_PLATFORM_ROLES=false
# Every route needs its RBAC_ROUTE_TABLE permission (server/rag/rbac.js).
RBAC_MODE=enforce
# A workspace must be registered and active, and the user must be a member.
TENANT_MEMBERSHIP=enforce

# --- PostgreSQL -------------------------------------------------------------
# The role split: the owner login runs migrations and DDL; the runtime login
# owns nothing and switches into the tenant or system role per transaction.
# Demo passwords (public values), the same ones compose.demo.yml gives
# create-split-roles.sql. compose.demo.yml replaces 127.0.0.1 by the postgres
# service.
POSTGRES_MIGRATION_DATABASE_URL=postgresql://archive_rag_owner:demo_owner_password@127.0.0.1:5432/archive_rag
POSTGRES_DATABASE_URL=postgresql://archive_rag_app:demo_runtime_password@127.0.0.1:5432/archive_rag
# The default, written out: tenant statements run under row-level security.
POSTGRES_ROW_LEVEL_SECURITY=enforce
# A statement with no tenant, system or request context fails instead of
# running as the owner.
POSTGRES_TENANT_CONTEXT=strict
# Tenant statements cannot hold a connection forever.
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
VECTOR_STORE_PROVIDER=pgvector
# Refuse to start when a health check fails (row-level security, role split).
STARTUP_HEALTH_STRICT=true

# --- Audit ------------------------------------------------------------------
# data.access events (downloads, deletes, clears, cross-tenant admin reads,
# tenant erase); a destructive action whose intent cannot be recorded is refused.
ADMIN_AUDIT_DATA_EVENTS=on
# Deleting a document also removes its text from settled runs, artifacts and
# feedback citations.
DOCUMENT_DELETE_REDACTION=on
ADMIN_AUDIT_RETENTION_DAYS=365
# A delete moves the document to its tenant's trash for 72 hours (restorable
# by its owner, invisible to everyone else); the retention sweep purges it
# after that, and only then redacts it from other records.
DOCUMENT_TRASH_RETENTION_HOURS=72

# --- Encryption at rest -----------------------------------------------------
# Stored PDF bytes (documents, ingest jobs and their stage outputs, upload
# chunks) are envelopes under a per-workspace key; a workspace erase destroys
# the key. Chunk text, embeddings, runs, feedback and memory stay plaintext
# (docs/demo-tenant-isolation.md, 限制).
TENANT_ENCRYPTION=on
# The demo-grade KMS: key files wrapped by a master key file on this machine.
TENANT_KMS_PROVIDER=local
# TENANT_KEYSTORE_DIR and TENANT_KMS_MASTER_KEY_FILE are left to their
# defaults on purpose: next to RAG_DATA_DIRECTORY, which is server/data/ for a
# local run (resolved from the server's own directory, not the shell's, and
# git-ignored) and /data in the image (the app volume; compose.demo.yml names
# both paths there). No one relative path fits both, and a wrong working
# directory must not create a master key inside the repository.

# --- Cache partitioning and memory scope ------------------------------------
# A query's cached embedding and a registry lookup are per tenant, so a cache
# hit's timing says nothing about another tenant's questions or workspaces.
RAG_EMBEDDING_CACHE_SCOPE=tenant
TENANT_REGISTRY_CACHE_SCOPE=tenant
# Long-term notes stay in the workspace they were written in; only the fixed
# reply-language and answer-style preferences follow the user.
LONG_MEMORY_SCOPE=workspace

# --- Per-tenant limits (deliberately small, so the walkthrough can hit them) -
# The per-IP limiter in front of authentication stays on but loose, so the
# walkthrough (one IP) meets the per-tenant limits first.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=3000
RATE_LIMIT_CHAT_MAX=300
RATE_LIMIT_UPLOAD_MAX=240
# Per IP on /documents/clear and /admin/tenants/erase (default 5).
RATE_LIMIT_DESTRUCTIVE_MAX=20
TENANT_RATE_LIMIT_ENABLED=true
TENANT_RATE_LIMIT_WINDOW_MS=60000
TENANT_RATE_LIMIT_CHAT_MAX=40
TENANT_RATE_LIMIT_INGEST_MAX=120
TENANT_RATE_LIMIT_DESTRUCTIVE_MAX=30
TENANT_RATE_LIMIT_DEFAULT_MAX=600
TENANT_MAX_CONCURRENT_RUNS=2
# Model quotas per workspace, applied in this process (no model gateway).
MODEL_QUOTA_ENABLED=true
MODEL_GATEWAY_QUOTA_REQUESTS_PER_MINUTE=300
MODEL_GATEWAY_QUOTA_TOKENS_PER_MINUTE=200000
MODEL_GATEWAY_QUOTA_DAILY_TOKENS=2000000
RAG_LLM_MAX_QUEUE=16
# Storage quotas per workspace: at most six documents of 25 MiB in total
# (documents in the trash count until they are purged).
TENANT_MAX_DOCUMENTS=6
TENANT_MAX_DOCUMENT_BYTES=26214400
# Asynchronous ingestion with per-workspace queue caps.
RAG_INGEST_MODE=async
RAG_INGEST_MAX_PENDING_JOBS_PER_WORKSPACE=20
RAG_INGEST_MAX_PENDING_BYTES_PER_WORKSPACE=268435456
# Background tasks per (user, workspace).
TENANT_MAX_RUNNING_TASKS=2
TENANT_MAX_QUEUED_TASKS=10
# The usage ledger is on by default with a database; flush often for the demo.
TENANT_USAGE_FLUSH_MS=5000

# --- Retention (days; 0 keeps forever) ---------------------------------------
AGENT_RUN_RETENTION_DAYS=30
TASK_RETENTION_DAYS=30
WORKSPACE_ARTIFACT_RETENTION_DAYS=90
FEEDBACK_RETENTION_DAYS=180

# --- Model: the deterministic demo model (npm run demo:fake-model) ----------
# No real model and no real key: hashed term embeddings and an answer made of
# the best-matching evidence sentence (server/demo/fake-model.js). To use a
# real OpenAI-compatible model instead, replace these lines (and start from an
# empty database: the vector width is fixed when the tables are created).
OPENAI_API_KEY=demo-fake-model-key
OPENAI_BASE_URL=http://127.0.0.1:5199/v1
OPENAI_CHAT_MODEL=demo-fake-chat
OPENAI_EMBEDDING_MODEL=demo-fake-embedding
RAG_EMBEDDING_DIMENSIONS=64
# The fake model cannot plan; the deterministic planners route every request.
AGENT_PLANNER_ROLLOUT=deterministic
AGENT_INTENT_PLANNER=deterministic
AGENT_EXECUTION_PLANNER=deterministic
PDF_PARSER=pdfjs

# --- Network ----------------------------------------------------------------
# The app's own origin (compose, the built SPA) and the Vite dev server
# (`npm start` from the repository root) for the browser demo.
ALLOWED_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,http://localhost:3000,http://127.0.0.1:3000
