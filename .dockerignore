# Keep secrets, local data and build output out of the image context.
.git
**/node_modules
build
coverage
**/.env
**/.env.*
!**/.env.example
server/data
server/uploads
server/upload-sessions
server/tmp-rag-data
server/feedback
server/evaluation/generated
# Local Python venvs (npm run rerank:cross-encoder:setup, about 1 GB with
# torch); COPY server/ would bake them into the app image.
server/evaluation/.venv*
server/evaluation/results
.playwright-mcp
