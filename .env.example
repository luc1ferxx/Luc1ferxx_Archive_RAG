VITE_DOMAIN=http://localhost:5001
VITE_API_AUTH_TOKEN=
# OIDC login (Authorization Code + PKCE, public client). The SPA reads the
# issuer, client id, scopes and audience from the API's GET /auth/config; the
# VITE_OIDC_ISSUER / VITE_OIDC_CLIENT_ID values below are only a fallback for
# when that endpoint is missing or unreachable. Register the redirect URI
# (default: this page's origin + "/", e.g. http://localhost:3000/) at the IdP.
# Access tokens stay in memory; a refresh token, if issued, in sessionStorage.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPES=openid profile email
VITE_OIDC_AUDIENCE=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=

RAG_RERANK_ENABLED=false
RAG_RERANK_CANDIDATE_MULTIPLIER=3
RAG_RERANK_WEIGHT=0.6
RAG_OBSERVABILITY_ENABLED=false
RAG_OBSERVABILITY_INCLUDE_CONTEXT=false
RAG_LLMOPS_POLICY_ENABLED=true
RAG_LLMOPS_ENFORCEMENT_MODE=record
# "same-origin" when the API server also serves this build (docker compose --profile app).
